{
  "name": "www",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/www/src",
  "projectType": "application",
  "tags": ["type:app", "scope:www"],
  "targets": {
    "brand-assets": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/public/favicon.svg",
        "{projectRoot}/public/logo.png",
        "{projectRoot}/public/og.jpg",
        "{projectRoot}/public/apple-touch-icon.png"
      ],
      "inputs": [
        "{projectRoot}/src/brand-assets.ts",
        "{projectRoot}/src/lib/mark.ts"
      ],
      "options": {
        "command": "pnpm exec vite-node --config vitest.config.ts src/brand-assets.ts",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["brand-assets"],
      "options": {
        "command": "vite dev",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["brand-assets"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "vite preview",
        "cwd": "{projectRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "wrangler deploy",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "prettier --check apps/www",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
