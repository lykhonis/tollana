{
  "name": "tollana",
  "private": true,
  "license": "Apache-2.0",
  "description": "Nx entry for the Tollana workspace",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "nx dev www",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nx/js": "23.1.1",
    "@nx/workspace": "23.1.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "nx": "23.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json,jsonc,yml,yaml}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "sharp",
      "workerd"
    ]
  }
}
