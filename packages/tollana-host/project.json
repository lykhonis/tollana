{
  "name": "tollana-host",
  "projectType": "library",
  "sourceRoot": "packages/tollana-host/src",
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --all -- --check",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "write": {
          "command": "cargo fmt --all"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p tollana-host --all-targets -- -D warnings",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p tollana-host --all-targets",
        "cwd": "{workspaceRoot}"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p tollana-host --all-targets",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
